{
  "name": "recivo",
  "version": "0.1.0",
  "description": "Caderno de receitas pessoal, local e offline (doces e salgadas).",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && electron .",
    "test": "node --test electron/",
    "test:e2e": "vite build && node scripts/e2e.mjs",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
